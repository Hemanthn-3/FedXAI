APP_NAME=FedPedia-XAI
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fedpedia_xai
POSTGRES_USER=fedpedia
POSTGRES_PASSWORD=change-this-in-your-local-env
DATABASE_URL=postgresql+asyncpg://fedpedia:change-this-in-your-local-env@postgres:5432/fedpedia_xai

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
SESSION_BACKEND=redis
RATE_LIMIT_BACKEND=redis
AUTH_RATE_LIMIT_PER_MINUTE=20

JWT_SECRET_KEY=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-long-random-refresh-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=fedpedia-xai
JWT_AUDIENCE=fedpedia-xai-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_ENABLED=true

ARTIFACT_ROOT=artifacts
REPORT_ROOT=reports

# ── Patient PHI field encryption (AES-256-GCM) ─────────────────────────────
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PATIENT_FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key

FL_SERVER_ADDRESS=0.0.0.0:8080
FL_ROUNDS=20
FL_CLIENTS=3
FL_EPOCHS=5
FL_BATCH_SIZE=32
FL_LR=0.001
FL_AGGREGATION_STRATEGY=fedavg
FL_DATASET_TYPE=heart_disease
FL_ARTIFACT_ROOT=artifacts/models

# ── Flower mTLS (mutual TLS) ────────────────────────────────────────────────
# Generate certs: python scripts/gen_certs.py
# Set FL_USE_MTLS=true and fill in paths once certs are generated.
FL_USE_MTLS=false
FL_CA_CERT_PATH=certs/ca.crt
FL_SERVER_CERT_PATH=certs/server.crt
FL_SERVER_KEY_PATH=certs/server.key
FL_CLIENT_CERT_PATH=certs/hospital_1.crt
FL_CLIENT_KEY_PATH=certs/hospital_1.key

# ── Differential Privacy (DP-SGD gradient noise) ───────────────────────────
# Set FL_DP_ENABLED=true to enable.  Higher noise_scale = more privacy, less accuracy.
FL_DP_ENABLED=false
FL_DP_NOISE_SCALE=1.0
FL_DP_MAX_GRAD_NORM=1.0
